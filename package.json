{
  "name": "lemomemo",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "柠檬记 4.0.0（App 主体、shared、构建与检查脚本）",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "lemo": {
    "allowScripts": []
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.shared.json && tsc -p tsconfig.functions.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "check:arch": "python -I build/check_arch.py",
    "check:site": "node build/build_site.mjs --check",
    "check:gate": "node build/check_version_gate.mjs",
    "gen:files-rules": "node build/gen_files_rules.mjs",
    "check:files-rules": "node build/gen_files_rules.mjs --check",
    "check:deno": "deno task check",
    "test": "vitest run",
    "test:tz": "node build/run_tz_tests.mjs",
    "test:deno": "deno task test",
    "test:compat": "node tests/compat/run-compat.ts",
    "test:db": "supabase test db supabase/tests/rls && deno task d1",
    "test:db:offline": "node supabase/tests/offline/run.mjs",
    "gen:manifest": "node tests/data-manifest/cli.ts --out dist/data-manifest",
    "build": "node build/build_web.mjs",
    "build:site": "node build/build_site.mjs",
    "size": "node build/check_size.mjs",
    "e2e": "playwright test",
    "copy:shared": "node build/copy_shared.mjs",
    "deps:rebuild": "node build/rebuild_allowed.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@supabase/supabase-js": "2.118.0",
    "aws4fetch": "1.0.20",
    "motion": "14.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postgres": "3.4.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "supabase": "2.120.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
