#!/bin/sh
# 改动热点：改到 30 天内已提交 3 次以上的源码文件，提交说明要带“重写评估：”（R-462，build/check_rewrite.py；CI 的 unit.yml 同一条规则再查一遍）。
# 不要用 --no-verify 绕过：先想清楚能不能整块重写，把结论写进提交说明。
py=python
command -v python >/dev/null 2>&1 || py=python3
"$py" -I build/check_rewrite.py --commit-msg "$1" || exit 1
# 改到动效、外观文件，提交说明要带“参考对照：”“参考外改动：”两行（负责人 11-18“提交时硬拦加上”，build/check_reference.py；CI 同一条再查）
"$py" -I build/check_reference.py --commit-msg "$1" || exit 1
# 修问题的提交要写“根因证据：……，排除了……”（负责人 11-24“你不确定的话能不能先问问我？”“每次都是这样”，build/check_rootcause.py；CI 同一条再查）
exec "$py" -I build/check_rootcause.py --commit-msg "$1"
