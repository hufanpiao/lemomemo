{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner/logs.schema.json",
  "title": "logs",
  "description": "运行日志（v3，ADR-010）：每台设备每天一条文档，id 为 <YYYY-MM-DD>_<设备号>。不记录任何内容字段。",
  "type": "object",
  "required": [
    "day",
    "device",
    "entries"
  ],
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "device": {
      "type": "string",
      "maxLength": 40
    },
    "updatedAt": {
      "type": "number",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "t",
          "kind",
          "act",
          "src"
        ],
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "op",
              "run"
            ]
          },
          "act": {
            "type": "string",
            "maxLength": 32
          },
          "src": {
            "enum": [
              "page",
              "chat",
              "task"
            ]
          },
          "coll": {
            "enum": [
              "events",
              "todos"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "code": {
            "type": "string",
            "maxLength": 40
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}