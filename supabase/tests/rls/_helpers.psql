-- RLS 测试的共用辅助（每个 *.test.sql 用 \ir _helpers.psql 引入；在测试事务里建，随 rollback 一起消失）
-- 用法：tests.try_as(角色, 用户, 'SQL')       → 'ok' 或 '<sqlstate> <错误信息>'；成功的写入保留到事务结束
--       tests.rows_as(角色, 用户, 'select …') → 结果行的 jsonb 数组
--       第四个参数给 fn_vault / fn_ai 的 app.uid（会话变量版 RLS），第五个参数给 JWT 的 session_id

-- 第二道防线（11-05 审查 S1）：只许打带标记的库。标记是数据库级参数 lemo.test_target，只有这三处会设：
--   CI 的 db 任务（ci.yml，db reset 之后设 'ci'）、lemo-e2e（tools/e2e/real-backend.mjs up 之后设 'e2e'）、离线 PGlite（offline/run.mjs 会话里设 'offline'）。
--   本机的 lemomemo、lemo-purgeit 没有这个标记：手敲 supabase test db（没带 --db-url 指 55322）打到它们时，这里先报错，
--   测试事务随之作废，后面的语句一条都不会生效。每个 *.test.sql 在 begin; select plan(n); 之后先 \ir 本文件或 _target.psql（只有这段检查，
--   逐字一致；复审 R1），由 tests/build/rls-target-include.test.ts 钉住。
do $$ begin
  if coalesce(current_setting('lemo.test_target', true), '') not in ('ci', 'e2e', 'offline') then
    raise exception 'rls 测试只许打 CI、lemo-e2e 或离线库（这个库没有 lemo.test_target 标记）。本机请 npm run e2e:real:up，再 supabase test db --db-url 指 127.0.0.1:55322';
  end if;
end $$;

create schema tests;

-- 真库上 postgres 不是超级用户：PG16 建角色时自动给的成员关系不带 SET，切不到 fn_vault、fn_ai；只在这个测试事务里补上
do $$ begin
  if not (select rolsuper from pg_roles where rolname = current_user) then
    execute 'grant fn_vault, fn_ai to ' || quote_ident(current_user) || ' with set true, inherit false';
  end if;
end $$;

create function tests.claims(p_role text, p_uid uuid, p_session uuid) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    jsonb_strip_nulls(jsonb_build_object('sub', p_uid, 'role', p_role, 'session_id', p_session))::text, true);
end $$;

create function tests.try_as(p_role text, p_uid uuid, p_sql text, p_app_uid uuid default null, p_session uuid default null)
  returns text language plpgsql as $$
declare r text := 'ok';
begin
  begin
    perform tests.claims(p_role, p_uid, p_session);
    perform set_config('app.uid', coalesce(p_app_uid::text, ''), true);
    execute format('set local role %I', p_role);
    execute p_sql;
    reset role;
  exception when others then
    r := sqlstate || ' ' || sqlerrm;
  end;
  reset role;
  perform set_config('request.jwt.claims', '', true);
  perform set_config('app.uid', '', true);
  return r;
end $$;

create function tests.rows_as(p_role text, p_uid uuid, p_sql text, p_app_uid uuid default null, p_session uuid default null)
  returns jsonb language plpgsql as $$
declare res jsonb;
begin
  begin
    perform tests.claims(p_role, p_uid, p_session);
    perform set_config('app.uid', coalesce(p_app_uid::text, ''), true);
    execute format('set local role %I', p_role);
    execute format('select coalesce(jsonb_agg(t), ''[]''::jsonb) from (%s) t', p_sql) into res;
    reset role;
  exception when others then
    res := jsonb_build_object('error', sqlstate || ' ' || sqlerrm);
  end;
  reset role;
  perform set_config('request.jwt.claims', '', true);
  perform set_config('app.uid', '', true);
  return res;
end $$;

-- 两个用户 A、B（各有 profile），一个停用的 C；每人一个会话
create function tests.seed() returns void language plpgsql as $$
begin
  insert into auth.users (id, email) values
    ('aaaaaaaa-0000-4000-8000-000000000001', 'a@test.local'),
    ('bbbbbbbb-0000-4000-8000-000000000002', 'b@test.local'),
    ('cccccccc-0000-4000-8000-000000000003', 'c@test.local');
  insert into public.profiles (user_id) values
    ('aaaaaaaa-0000-4000-8000-000000000001'), ('bbbbbbbb-0000-4000-8000-000000000002');
  insert into public.profiles (user_id, disabled_at, disabled_reason) values
    ('cccccccc-0000-4000-8000-000000000003', now(), 'admin');
  insert into auth.sessions (id, user_id) values
    ('aaaaaaaa-5555-4000-8000-000000000001', 'aaaaaaaa-0000-4000-8000-000000000001'),
    ('bbbbbbbb-5555-4000-8000-000000000002', 'bbbbbbbb-0000-4000-8000-000000000002');
end $$;
