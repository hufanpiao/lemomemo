-- expect: private.enqueue_anniv_defaults 往 remind_queue 插入 1 处，只有 0 处冲突时清租约
-- REMIND-queue-crash-loss（迁移 20261104130000）：一个入队入口退回 on conflict do nothing，正被租着的项被用户改了也不清租约，
-- 第 0 步的 finish 会把它删掉（吞掉新改动）
create or replace function private.enqueue_anniv_defaults() returns trigger
  language plpgsql security definer set search_path = '' as $$
begin
  insert into private.remind_queue (table_name, id)
    select 'anniversaries', a.id from public.anniversaries a
     where a.user_id = new.user_id and a.deleted_at is null and (a.remind_offsets is null or a.remind_time is null)
  on conflict do nothing;
  return null;
end $$;
