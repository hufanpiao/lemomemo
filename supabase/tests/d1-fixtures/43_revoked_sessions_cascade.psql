-- expect: private.revoked_sessions 写 onAccountDelete: keep-id-only，user_id 却 on delete cascade
-- R-382（架构 4.1a 第 4 点，安全审 M5）：注销后吊销记录要留着（只留哈希），离线的丢失设备一联网还能查出“被移除”；
-- 外键改回 on delete cascade，注销就把记录一起删了
alter table private.revoked_sessions drop constraint revoked_sessions_user_id_fkey;
alter table private.revoked_sessions add foreign key (user_id) references auth.users on delete cascade;
