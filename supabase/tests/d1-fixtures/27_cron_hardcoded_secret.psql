-- expect: 的命令里有写死的长串
-- 0.38 第 46 条：cron 调函数的密钥一律放数据库 Vault，运行时从 vault.decrypted_secrets 读；这里把 x-cron-secret 的值写死进命令（假值写成低熵，免得 gitleaks 当真密钥）
select cron.schedule('qa-probe', '30 18 * * *',
  $$select net.http_post(url := 'http://kong:8000/functions/v1/account-purge',
      headers := jsonb_build_object('x-cron-secret', 'fakefakefakefakefakefake0000000000000000'), body := '{}'::jsonb)$$);
