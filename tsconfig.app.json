{
  // 前端（App 主体、预览沙箱）：带 DOM。SW 用 WebWorker 库，另见 tsconfig.sw.json
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["src/sw/**", "src/**/__tests__/**"]
}
